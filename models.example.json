{
  "version": 1,
  "_comment": "模型清单：种类 + 密钥 + 型号。数组顺序 = 优先级（1 号优先，失败自动切下一个）。type 分 text（文本）和 image（生图）；生图模型用 api=images（/images/generations，OpenAI 标准）或 api=chat（多模态内联返回，如 AIHubMix）。改完保存即生效，不用重建镜像、不用重启。",

  "defaults": {
    "timeout": 90,
    "temperature": 0.7
  },

  "providers": [
    {
      "id": "deepseek",
      "name": "DeepSeek",
      "base_url": "https://api.deepseek.com/v1",
      "api_key": "",
      "model": "deepseek-chat",
      "max_tokens": 8192
    },
    {
      "id": "siliconflow",
      "name": "硅基流动",
      "base_url": "https://api.siliconflow.cn/v1",
      "api_key": "",
      "models": ["Qwen/Qwen2.5-7B-Instruct"],
      "max_tokens": 4096
    },
    {
      "id": "aihubmix",
      "name": "AIHubMix（生图）",
      "type": "image",
      "api": "chat",
      "base_url": "https://aihubmix.com/v1",
      "api_key": "",
      "model": "gemini-3.1-flash-image-preview",
      "timeout": 120
    },
    {
      "id": "openai-image",
      "name": "OpenAI 图像（示例，默认关）",
      "type": "image",
      "api": "images",
      "base_url": "https://api.openai.com/v1",
      "api_key": "",
      "model": "gpt-image-1",
      "enabled": false,
      "timeout": 120
    }
  ]
}
